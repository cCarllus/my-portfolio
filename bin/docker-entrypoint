#!/bin/bash -e

# Fly volumes are mounted as root; make /data writable by the rails user.
if [ -d /data ] && [ "$(id -u)" = "0" ]; then
  chown -R rails:rails /data
fi

run_db_prepare=false
args=("$@")
for ((i = 0; i < ${#args[@]} - 1; i++)); do
  if { [ "${args[i]}" = "./bin/rails" ] || [ "${args[i]}" = "bin/rails" ]; } && [ "${args[i + 1]}" = "server" ]; then
    run_db_prepare=true
    break
  fi
done

if [ "${1}" = "bin/rails" ] && [ "${2}" = "db:prepare" ]; then
  run_db_prepare=true
fi

if [ "$run_db_prepare" = true ]; then
  if [ "$(id -u)" = "0" ]; then
    gosu rails:rails ./bin/rails db:prepare
  else
    ./bin/rails db:prepare
  fi
fi

if [ "$(id -u)" = "0" ]; then
  exec gosu rails:rails "$@"
else
  exec "$@"
fi