<header class="admin-page-header">
  <div><h1><%= t("admin.skills.title") %></h1><p><%= t("admin.skills.description") %></p></div>
  <%= link_to t("admin.actions.new"), new_admin_skill_path, class: "admin-button" %>
</header>
<section data-controller="sortable" data-sortable-url-value="<%= reorder_admin_skills_path %>" data-sortable-error-value="<%= t("admin.sortable.error") %>">
<p class="admin-sort-help"><%= t("admin.sortable.help") %> <span data-sortable-target="status"></span></p>
<div class="admin-list">
  <% @records.each do |skill| %>
    <article class="admin-list__item" data-sortable-target="item" data-id="<%= skill.id %>">
      <button type="button" class="admin-drag-handle" aria-label="<%= t("admin.sortable.handle") %>" data-action="pointerdown->sortable#start pointermove->sortable#move pointerup->sortable#finish pointercancel->sortable#cancel mousedown->sortable#start mousemove@window->sortable#move mouseup@window->sortable#finish">⋮⋮</button>
      <span class="admin-color-swatch" style="--skill-color: <%= skill.color %>"></span>
      <div><strong><%= skill.name %></strong><span><%= skill.category %> · <%= skill.color %></span></div>
      <div class="admin-list__actions">
        <%= link_to t("admin.actions.edit"), edit_admin_skill_path(skill) %>
        <%= button_to t("admin.actions.delete"), admin_skill_path(skill), method: :delete, data: { turbo_confirm: t("admin.actions.confirm") } %>
      </div>
    </article>
  <% end %>
</div>
</section>
