<%= form_with model: [ :admin, record ], class: "admin-form" do |form| %>
  <%= render "admin/shared/errors", record: %>
  <div class="admin-form__grid">
    <% %i[name category].each do |attribute| %>
      <label class="admin-field"><span><%= t("admin.fields.#{attribute}") %></span><%= form.text_field attribute %></label>
    <% end %>
  </div>
  <% unless record.new_record? %>
    <p class="admin-color-note">
      <span style="--skill-color: <%= record.color %>"></span>
      <%= t("admin.skills.automatic_color", color: record.color) %>
    </p>
  <% end %>
  <div class="admin-form__section admin-form__grid">
    <label class="admin-check"><%= form.check_box :featured %><%= t("admin.fields.featured") %></label>
    <label class="admin-check"><%= form.check_box :published %><%= t("admin.fields.published") %></label>
  </div>
  <div class="admin-form__actions"><%= form.submit t("admin.actions.save") %><%= link_to t("admin.actions.cancel"), admin_skills_path, class: "admin-button admin-button--secondary" %></div>
<% end %>
