<header class="admin-page-header">
  <div>
    <h1><%= t("admin.dashboard.title") %></h1>
    <p><%= t("admin.dashboard.description") %></p>
  </div>
</header>

<section class="admin-stats">
  <% @counts.each do |name, count| %>
    <article class="admin-stat">
      <span><%= t("admin.dashboard.stats.#{name}") %></span>
      <strong><%= count %></strong>
    </article>
  <% end %>
</section>

<section class="admin-grid">
  <article class="admin-card">
    <h2><%= t("admin.dashboard.content_title") %></h2>
    <p><%= t("admin.dashboard.content_description") %></p>
  </article>
  <article class="admin-card">
    <h2><%= t("admin.dashboard.recent_requests") %></h2>
    <% @recent_requests.each do |request| %>
      <p><%= request.email %> · <%= l(request.created_at, format: :short) %></p>
    <% end %>
  </article>
</section>
