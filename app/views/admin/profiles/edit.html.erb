<header class="admin-page-header">
  <div>
    <h1><%= t("admin.profile.title") %></h1>
    <p><%= t("admin.profile.description") %></p>
  </div>
</header>

<%= form_with model: @profile, url: admin_profile_path, class: "admin-form" do |form| %>
  <%= render "admin/shared/errors", record: @profile %>

  <div class="admin-form__grid">
    <% %i[full_name nickname contact_email phone linkedin_url github_url].each do |attribute| %>
      <label class="admin-field">
        <span><%= t("admin.fields.#{attribute}") %></span>
        <%= form.text_field attribute %>
      </label>
    <% end %>
    <%= render "admin/shared/remote_file_fields",
      form:,
      file_field: :avatar,
      url_field: :avatar_url,
      file_label: t("admin.fields.avatar"),
      url_label: t("admin.fields.avatar_url"),
      file_accept: "image/*",
      current_filename: (@profile.avatar.attached? ? @profile.avatar.filename : nil) %>
  </div>

  <%= render "admin/shared/translated_fields", form:, attribute: :roles, title: t("admin.fields.roles") %>
  <%= render "admin/shared/translated_fields", form:, attribute: :locations, title: t("admin.fields.locations") %>
  <%= render "admin/shared/translated_fields", form:, attribute: :philosophies, title: t("admin.fields.philosophies") %>

  <div class="admin-form__actions"><%= form.submit t("admin.actions.save") %></div>
<% end %>
