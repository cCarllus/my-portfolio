<%= form_with model: [ :admin, record ], class: "admin-form" do |form| %>
  <%= render "admin/shared/errors", record: %>
  <div class="admin-form__grid">
    <label class="admin-check"><%= form.check_box :published %><%= t("admin.fields.published") %></label>
  </div>
  <%= render "admin/shared/translated_fields", form:, attribute: :courses, title: t("admin.fields.courses") %>
  <%= render "admin/shared/translated_fields", form:, attribute: :institutions, title: t("admin.fields.institutions") %>
  <%= render "admin/shared/translated_fields", form:, attribute: :statuses, title: t("admin.fields.statuses") %>
  <div class="admin-form__actions"><%= form.submit t("admin.actions.save") %><%= link_to t("admin.actions.cancel"), admin_educations_path, class: "admin-button admin-button--secondary" %></div>
<% end %>
