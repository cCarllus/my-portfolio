<%= form_with model: [ :admin, record ], class: "admin-form" do |form| %>
  <%= render "admin/shared/errors", record: %>
  <div class="admin-form__grid">
    <label class="admin-field"><span><%= t("admin.fields.metric") %></span><%= form.text_field :metric %></label>
    <label class="admin-check"><%= form.check_box :published %><%= t("admin.fields.published") %></label>
  </div>
  <%= render "admin/shared/translated_fields", form:, attribute: :titles, title: t("admin.fields.titles") %>
  <%= render "admin/shared/translated_fields", form:, attribute: :descriptions, title: t("admin.fields.descriptions"), textarea: true %>
  <div class="admin-form__actions"><%= form.submit t("admin.actions.save") %><%= link_to t("admin.actions.cancel"), admin_highlights_path, class: "admin-button admin-button--secondary" %></div>
<% end %>
