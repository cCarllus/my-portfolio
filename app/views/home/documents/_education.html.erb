<div class="education-file">
  <header class="file-showcase__intro">
    <span><%= t("home.index.documents.generated.live_data") %></span>
    <p><%= t("home.index.documents.generated.education_intro") %></p>
  </header>

  <div class="education-file__list">
    <% portfolio.educations.each_with_index do |education, index| %>
      <article>
        <div class="education-file__year"><%= format("%02d", index + 1) %></div>
        <div>
          <span><%= education.localized(:statuses) %></span>
          <h3><%= education.localized(:courses) %></h3>
          <p><%= education.localized(:institutions) %></p>
        </div>
      </article>
    <% end %>
  </div>
</div>
