<% content_for :title, @portfolio ? "#{@portfolio.full_name} — Portfolio" : t("meta.title") %>
<% content_for :description, @portfolio&.summary || t("meta.description") %>

<% if @portfolio %>
  <main class="portfolio-shell" data-controller="document-modal">
    <% flash.each do |type, message| %>
      <div class="portfolio-notice portfolio-notice--<%= type %>"><%= message %></div>
    <% end %>

    <nav class="portfolio-nav panel" aria-label="<%= t(".navigation.label") %>">
      <div class="identity">
        <% if @portfolio.avatar_available? %>
          <%= image_tag @portfolio.avatar_display_url, class: "identity__avatar", alt: t(".navigation.avatar_alt"), width: 28, height: 28 %>
        <% end %>
        <span><%= t(".navigation.greeting_dynamic", name: @portfolio.full_name, nickname: @portfolio.nickname) %> <span aria-hidden="true">👋</span></span>
      </div>

      <div class="nav-tools">
        <label class="language-picker">
          <span class="sr-only"><%= t(".navigation.language_label") %></span>
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>
          <%= select_tag :locale,
            options_for_select(I18n.available_locales.map { |locale| [t(".navigation.languages.#{locale}"), locale] }, I18n.locale),
            aria: { label: t(".navigation.language_label") },
            data: { controller: "locale", action: "change->locale#change" } %>
        </label>

        <div class="local-time" data-controller="clock" data-clock-locale-value="<%= I18n.locale %>" aria-label="<%= t(".navigation.local_time") %>">
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
          <time data-clock-target="time"></time>
          <time data-clock-target="date"></time>
        </div>

        <button class="theme-toggle" type="button" data-action="theme#toggle" data-theme-target="button" aria-label="<%= t(".navigation.change_theme") %>" aria-pressed="true">
          <span class="theme-toggle__track" aria-hidden="true"><span></span></span>
          <span data-theme-target="label" data-dark-label="<%= t(".navigation.dark") %>" data-light-label="<%= t(".navigation.light") %>"><%= t(".navigation.dark") %></span>
        </button>
      </div>
    </nav>

    <section class="portfolio-grid portfolio-grid--top" aria-label="<%= t(".profile.section_label") %>">
      <article class="code-card panel" aria-label="<%= t(".profile.code_label") %>">
        <div class="code-card__lines" aria-hidden="true">
          <% (1..16).each { |line| %><span><%= line %></span><% } %>
        </div>
        <pre class="code-card__content"><code><span class="code-keyword">class</span> <span class="code-class"><%= @portfolio.class_name %></span>
  <span class="code-keyword">def</span> <span class="code-method">initialize</span>
    <span class="code-instance">@name</span> <span class="code-operator">=</span> <span class="code-string">"<%= @portfolio.full_name %>"</span>
    <span class="code-instance">@role</span> <span class="code-operator">=</span> <span class="code-string">"<%= @portfolio.role %>"</span>
    <span class="code-instance">@location</span> <span class="code-operator">=</span> <span class="code-string">"<%= @portfolio.location %>"</span>
    <span class="code-instance">@stack</span> <span class="code-operator">=</span> <span class="code-punctuation">[</span>
      <% @portfolio.code_stack.each_with_index do |skill, index| %><span class="code-value">"<%= skill %>"</span><%= tag.span(",", class: "code-punctuation") unless index == @portfolio.code_stack.length - 1 %> <% end %>
    <span class="code-punctuation">]</span>
    <span class="code-instance">@philosophy</span> <span class="code-operator">=</span> <span class="code-string">"<%= @portfolio.philosophy %>"</span>
  <span class="code-keyword">end</span>
<span class="code-keyword">end</span>

<span class="code-keyword">if</span> <span class="code-constant">__FILE__</span> <span class="code-operator">==</span> <span class="code-global">$PROGRAM_NAME</span>
  <span class="code-name">me</span> <span class="code-operator">=</span> <span class="code-class"><%= @portfolio.class_name %></span><span class="code-punctuation">.</span><span class="code-method">new</span>
  <span class="code-method">puts</span> <span class="code-name">me</span><span class="code-cursor" aria-hidden="true">|</span>
<span class="code-keyword">end</span></code></pre>
      </article>

      <article class="skills-card panel" aria-label="<%= t(".skills.label") %>" data-controller="dialog">
        <div class="skills-marquee">
          <% @portfolio.skill_lanes.each_with_index do |lane, lane_index| %>
            <div class="skill-lane <%= "skill-lane--reverse" if lane_index.odd? %>">
              <div class="skill-lane__track">
                <% 2.times do |copy| %>
                  <div class="skill-lane__sequence" aria-hidden="<%= copy.positive? %>">
                    <% lane.each do |skill| %>
                      <span class="skill-pill" style="--skill-color: <%= skill.color %>"><%= skill.name %></span>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <% if @portfolio.skills_overflow? %>
          <button type="button" class="skills-card__all" data-action="dialog#open">
            <%= t(".skills.show_all", count: @portfolio.skills.size) %>
          </button>
        <% end %>

        <dialog class="skills-modal" data-dialog-target="dialog" data-action="click->dialog#closeFromBackdrop close->dialog#closed" aria-labelledby="skills-modal-title">
          <div class="skills-modal__surface">
            <header class="document-modal__header">
              <div><span><%= t(".skills.eyebrow") %></span><h2 id="skills-modal-title"><%= t(".skills.all_title") %></h2></div>
              <button class="document-modal__close" type="button" data-action="dialog#close" aria-label="<%= t(".skills.close") %>">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg>
              </button>
            </header>
            <div class="skills-modal__grid">
              <% @portfolio.skills.each do |skill| %>
                <div class="skills-modal__item">
                  <span class="skill-color-dot" style="--skill-color: <%= skill.color %>"></span>
                  <div><strong><%= skill.name %></strong><small><%= skill.category %></small></div>
                </div>
              <% end %>
            </div>
          </div>
        </dialog>
      </article>

      <article class="experience-card panel" data-controller="tabs">
        <% projects_document = @portfolio.documents.find { |document| document.content_kind == "highlights" } %>
        <div class="tabs" role="tablist" aria-label="<%= t(".experience.label") %>">
          <% %i[work projects education].each_with_index do |tab, index| %>
            <button
              type="button"
              role="tab"
              id="<%= tab %>-tab"
              aria-controls="<%= tab %>-panel"
              aria-selected="<%= index.zero? %>"
              tabindex="<%= index.zero? ? 0 : -1 %>"
              class="tab <%= "tab--active" if index.zero? %>"
              data-tabs-target="tab"
              data-action="tabs#select<%= " document-modal#open" if tab == :projects && projects_document %>"
              <% if tab == :projects && projects_document %>
                data-document-modal-panel-param="document-<%= projects_document.id %>"
                data-document-modal-title-param="<%= projects_document.localized(:titles) %>"
              <% end %>>
              <%= t(".experience.tabs.#{tab}") %>
            </button>
          <% end %>
        </div>

        <% @portfolio.tab_items.each_with_index do |(name, items), index| %>
          <div class="timeline" id="<%= name %>-panel" role="tabpanel" aria-labelledby="<%= name %>-tab" data-tabs-target="panel" <%= "hidden" unless index.zero? %>>
            <% items.each do |item| %>
              <div class="timeline__item">
                <div><strong><%= item[:name] %></strong><span><%= item[:role] %></span></div>
                <time><%= item[:period] %></time>
              </div>
            <% end %>
          </div>
        <% end %>
      </article>
    </section>

    <section class="portfolio-grid portfolio-grid--bottom" aria-label="<%= t(".details.section_label") %>">
      <article class="map-card panel" aria-label="<%= t(".location.label") %>">
        <div class="location-pin" style="left: <%= @portfolio.map_x_percent %>%; top: <%= @portfolio.map_y_percent %>%;">
          <span class="location-pin__pulse" aria-hidden="true"></span>
          <span class="location-pin__dot" aria-hidden="true"></span>
          <span class="location-pin__tooltip"><%= @portfolio.map_label %></span>
        </div>
      </article>

      <article class="access-card panel">
        <div class="access-card__tab" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        </div>
        <div class="access-card__content">
          <h2><%= t(".access.title") %></h2>
          <%= form_with scope: :contact_request, url: portfolio_request_path do |form| %>
            <label class="passcode-field">
              <span class="sr-only"><%= t(".access.email_label") %></span>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 6h16v12H4zM4 7l8 6 8-6"/></svg>
              <%= form.email_field :email, required: true, autocomplete: "email", placeholder: t(".access.email_placeholder") %>
            </label>
            <%= form.text_field :website, tabindex: -1, autocomplete: "off", class: "contact-honeypot", aria: { hidden: true } %>
            <p><%= t(".access.email_description") %></p>
            <%= form.submit t(".access.email_button") %>
          <% end %>
        </div>
      </article>

      <article class="documents-card panel" aria-label="<%= t(".documents.label") %>">
        <div class="documents-grid">
          <% @portfolio.documents.each_with_index do |document, index| %>
            <% resource = @portfolio.document_resource(document) %>
            <button class="document" type="button" data-action="document-modal#open" data-document-modal-panel-param="document-<%= document.id %>" data-document-modal-title-param="<%= document.localized(:titles) %>">
              <span class="document__icon">
                <% if resource&.content_type == "application/pdf" %>
                  <span class="document__pdf">PDF</span>
                <% else %>
                  <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 7h10M7 11h<%= index.even? ? 10 : 7 %>M7 15h9"/></svg>
                <% end %>
                <span class="document__fold" aria-hidden="true"></span>
              </span>
              <span><%= document.localized(:titles) %></span>
            </button>
          <% end %>
        </div>
      </article>
    </section>

    <footer class="portfolio-footer panel">
      <nav aria-label="<%= t(".footer.label") %>">
        <% @portfolio.social_links.each do |name, url| %>
          <%= link_to name, url, target: url.start_with?("http") ? "_blank" : nil, rel: url.start_with?("http") ? "noopener" : nil %>
        <% end %>
      </nav>
    </footer>

    <dialog class="document-modal" data-document-modal-target="dialog" data-action="click->document-modal#closeFromBackdrop close->document-modal#closed" aria-labelledby="document-modal-title">
      <div class="document-modal__surface">
        <header class="document-modal__header">
          <div><span><%= t(".documents.modal.eyebrow") %></span><h2 id="document-modal-title" data-document-modal-target="title"></h2></div>
          <button class="document-modal__close" type="button" data-action="document-modal#close" aria-label="<%= t(".documents.modal.close") %>">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg>
          </button>
        </header>
        <div class="document-modal__body" data-document-modal-target="body">
          <% @portfolio.documents.each do |document| %>
            <% resource = @portfolio.document_resource(document) %>
            <section class="document-panel document-panel--<%= document.content_kind %>" data-document-modal-target="panel" data-panel="document-<%= document.id %>" hidden>
              <% case document.content_kind %>
              <% when "experience" %>
                <%= render "home/documents/experience", portfolio: @portfolio %>
              <% when "skills" %>
                <%= render "home/documents/skills", portfolio: @portfolio %>
              <% when "highlights" %>
                <%= render "home/documents/highlights", portfolio: @portfolio %>
              <% when "education" %>
                <%= render "home/documents/education", portfolio: @portfolio %>
              <% else %>
                <div class="document-panel__lead"><%= render_markdown(document.localized(:bodies)) %></div>
              <% end %>

              <% if resource %>
                <% open_url = resource.url_based? ? resource.open_url : rails_blob_path(resource.attachment, disposition: "inline") %>
                <% download_url = resource.url_based? ? resource.download_url : rails_blob_path(resource.attachment, disposition: "attachment") %>
                <% preview_url = resource.url_based? ? resource.preview_url : rails_blob_path(resource.attachment, disposition: "inline") %>
                <div class="resume-actions">
                  <%= link_to t(".documents.resume.open"), open_url, target: "_blank", rel: "noopener" %>
                  <%= link_to t(".documents.resume.download"), download_url %>
                </div>
                <% if resource.content_type == "application/pdf" %>
                  <iframe src="<%= preview_url %>#view=FitH" title="<%= document.localized(:titles) %>"></iframe>
                <% elsif resource.content_type.to_s.start_with?("image/") %>
                  <% if resource.url_based? %>
                    <%= image_tag preview_url, class: "document-preview-image", alt: document.localized(:titles) %>
                  <% else %>
                    <%= image_tag resource.attachment, class: "document-preview-image", alt: document.localized(:titles) %>
                  <% end %>
                <% end %>
              <% end %>
            </section>
          <% end %>
        </div>
      </div>
    </dialog>
  </main>
<% else %>
  <main class="portfolio-shell">
    <div class="panel portfolio-empty"><%= t(".empty") %></div>
  </main>
<% end %>
